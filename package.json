{
    "name":  "amaduce-training-simulator",
    "version":  "1.0.0",
    "description":  "WFA Amadeus GDS Training Simulator - Desktop Edition",
    "main":  "main.js",
    "author":  "Wings Fly Aviation Academy",
    "license":  "MIT",
    "scripts":  {
                    "start":  "node node_modules/electron/cli.js .",
                    "build-win":  "electron-builder --win --ia32",
                    "build-portable":  "electron-builder --win portable"
                },
    "devDependencies":  {
                            "electron":  "^28.0.0",
                            "electron-builder":  "^24.0.0"
                        },
    "build":  {
                  "appId":  "com.wingsflyaviation.amaduce-training",
                  "productName":  "Amaduce Training Simulator",
                  "copyright":  "Copyright 2024 Wings Fly Aviation Academy",
                  "files":  [
                                "index.html",
                                "main.js"
                            ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "ia32",
                                                              "x64"
                                                          ]
                                             },
                                             {
                                                 "target":  "portable"
                                             }
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true
                           }
              }
}
